{
  "name": "viago-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "db:business-ids": "prisma db execute --file prisma/sql/business-ids.sql --schema prisma/schema.prisma",
    "intake:seed": "node scripts/intake-seed.cjs",
    "content:migrate": "node scripts/content-pages-migrate.cjs",
    "content:db:setup": "prisma db execute --file prisma/sql/site-content.sql --schema prisma/schema.prisma",
    "admin:password": "node scripts/admin-password.cjs",
    "admin:seed-passwords": "node scripts/admin-seed-passwords.cjs",
    "chatbot:priority:sync": "node scripts/chatbot-priority-sync.cjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "chatbot:status": "node scripts/chatbot-status.cjs",
    "chatbot:db:setup": "prisma db execute --file prisma/sql/customer-support.sql --schema prisma/schema.prisma",
    "chatbot:knowledge:sync": "npm run build && node scripts/chatbot-sync-knowledge.cjs",
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "prestart": "node scripts/check-port.cjs",
    "dev": "npm run start:dev",
    "start:dev": "nest start --watch --path tsconfig.dev.json",
    "prestart:dev": "node scripts/check-port.cjs",
    "start:debug": "nest start --debug --watch --path tsconfig.dev.json",
    "prestart:debug": "node scripts/check-port.cjs",
    "start:prod": "node dist/main.js",
    "prestart:prod": "node scripts/check-port.cjs",
    "lint": "oxlint --type-aware src/ test/",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:intake": "npm run build && node test/intake.integration.cjs",
    "test:content": "npm run build && node test/content.integration.cjs",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "db:intake-workflow": "prisma db execute --file prisma/sql/intake-workflow.sql --schema prisma/schema.prisma",
    "test:booking": "npm run build && node test/booking.integration.cjs",
    "test:home": "npm run build && node test/home.integration.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "jest": "^30.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2"
  }
}
