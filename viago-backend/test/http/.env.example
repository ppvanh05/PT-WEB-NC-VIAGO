# Mau cau hinh cho bo thu API test/http/nghi-modules.http (extension REST Client).
#
# Cach dung: chep tep nay thanh test/http/.env roi dien gia tri thuc te.
#   cp test/http/.env.example test/http/.env
# Tep .env da nam trong .gitignore nen khong bi day len GitHub.
#
# Day la mat khau cua cac tai khoan mau trong Supabase chung cua nhom.
# Chung chi dang nhap duoc khi chay o may ca nhan:
#   NODE_ENV=development
#   ADMIN_ALLOW_LOCAL_SEED_LOGIN=true  (hoac CUSTOMER_ALLOW_LOCAL_SEED_LOGIN=true)
#   va yeu cau phai den tu 127.0.0.1
# Du vay van khong duoc commit chung, vi day la mat khau cua tai khoan that.

# Tai khoan quan tri
VIAGO_SEED_ADMIN_USERNAME=
VIAGO_SEED_ADMIN_PASSWORD=

# Tai khoan nhan vien dieu phoi
VIAGO_SEED_DISPATCHER_USERNAME=
VIAGO_SEED_DISPATCHER_PASSWORD=

# Tai khoan khach hang (dang nhap bang email)
VIAGO_SEED_CUSTOMER_USERNAME=
VIAGO_SEED_CUSTOMER_PASSWORD=
