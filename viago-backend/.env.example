DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&sslmode=require&connect_timeout=10"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require&connect_timeout=10"
PORT=3000
FRONTEND_ORIGIN=http://localhost:4200
NEWS_SCHEDULER_ENABLED=true
COMPANY_HOTLINE="1900 1234"
COMPANY_EMAIL=congtyviago@gmail.com
COMPANY_ADDRESS="869 Đỗ Mười, Khu phố 13, Linh Xuân, TP. HCM"
# Private CV directory; use a persistent private volume when deploying.
CV_UPLOAD_DIR=uploads/private/cv

# Hosted AI: deploy the backend with these server-only environment variables.
CHATBOT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_MAX_REPLY_TOKENS=400
OPENAI_MAX_ANALYSIS_TOKENS=600
# Optional alternative hosted provider: set CHATBOT_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CHATBOT_TIMEOUT_MS=60000
# Optional self-hosted provider: set CHATBOT_PROVIDER=ollama instead.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Staff must have this exact permission in nhan_vien_quyen_han.
CHATBOT_SUPPORT_PERMISSION=CSKH_CHAT
CHATBOT_KNOWLEDGE_PERMISSION=CSKH_KIEN_THUC
# Optional OpenAI semantic retrieval; keyword RAG works without embeddings.
CHATBOT_EMBEDDINGS_ENABLED=false

# VietQR / SePay: fill server-side after linking the receiving bank in SePay.
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
# Exact gateway name in SePay webhook payload, e.g. the linked bank's gateway.
SEPAY_BANK_NAME=
# Shared webhook secret (32+ characters); configure the SAME API Key in SePay.
SEPAY_WEBHOOK_API_KEY=