# Copy to .env and fill in your own values. Never commit .env or real secrets.
# Variables currently present in the local .env (same order).
# Database URLs: use your database connection strings, including URL-encoded passwords.
# SePay: replace the example bank/account values with your own test-mode configuration.
# SEPAY_WEBHOOK_SECRET: HMAC secret from SePay. Keep this on the backend only.
# ACCOUNT_OTP_MODE=test: development only; OTP codes appear in the backend terminal.
# FRONTEND_ORIGIN: replace localhost with the allowed frontend origin when deploying.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
PORT=3000
FRONTEND_ORIGIN=http://localhost:4200
NEWS_SCHEDULER_ENABLED=true
COMPANY_HOTLINE=YOUR_COMPANY_HOTLINE
COMPANY_EMAIL=contact@example.com
COMPANY_ADDRESS="YOUR_COMPANY_ADDRESS"
CV_UPLOAD_DIR=./uploads/cv
SEPAY_MODE=test
SEPAY_WEBHOOK_SECRET=
VIETQR_BANK_ID=970448
VIETQR_ACCOUNT_NO=YOUR_TEST_ACCOUNT_NUMBER
VIETQR_ACCOUNT_NAME="YOUR_TEST_ACCOUNT_NAME"
SEPAY_ACCOUNT_NO=YOUR_TEST_VIRTUAL_ACCOUNT_NUMBER
SEPAY_BANK_NAME=OCB
ACCOUNT_OTP_MODE=test

# Optional settings supported by the app; not currently set in the local .env.
# SMS mode requires ACCOUNT_SMS_WEBHOOK_URL (HTTPS) and ACCOUNT_SMS_WEBHOOK_TOKEN.
# Chatbot: choose the provider you configure and fill in its credentials.
# Local seed login flags should remain false outside isolated local development.
REVIEW_UPLOAD_DIR=./uploads/reviews
ACCOUNT_SMS_WEBHOOK_URL=
ACCOUNT_SMS_WEBHOOK_TOKEN=
CHATBOT_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_REPLY_TOKENS=1000
OPENAI_MAX_ANALYSIS_TOKENS=2000
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CHATBOT_TIMEOUT_MS=30000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
CHATBOT_SUPPORT_PERMISSION=CSKH_CHAT
CHATBOT_KNOWLEDGE_PERMISSION=CSKH_KIEN_THUC
CHATBOT_EMBEDDINGS_ENABLED=false
SEPAY_WEBHOOK_API_KEY=
ADMIN_ALLOW_LOCAL_SEED_LOGIN=false
CUSTOMER_ALLOW_LOCAL_SEED_LOGIN=false
