generator client {
  provider = "prisma-client-js"
}

model noi_dung_trang {
  slug            String   @id @db.VarChar(100)
  loai            String   @db.VarChar(30)
  tieude          String   @db.VarChar(255)
  noidung         Json
  thutu           Int      @default(0)
  trangthai       String   @default("DaXuatBan") @db.VarChar(30)
  thoigiantao     DateTime @default(now()) @db.Timestamptz(6)
  thoigiancapnhat DateTime @default(now()) @db.Timestamptz(6)

  @@index([loai, thutu], map: "noi_dung_trang_loai_thutu_idx")
}

// Private support data. Access only through the authenticated support API.
model hoi_thoai_chatbot {
  id              String   @id @db.VarChar @map("mahoithoai")
  ownerHash       String   @db.VarChar(64) @map("mabamchusohuu")
  status          trang_thai_hoi_thoai_chatbot_enum @default(TroLyAI) @map("trangthai")
  language        String   @default("vi") @db.VarChar(8) @map("ngonngu")
  assignedAgentId String?   @db.VarChar @map("manhanvienphutrach")
  priority        Int      @default(0) @map("diemuutien")
  analysis        Json? @map("phantich")
  handoff         Json? @map("thongtinchuyentiep")
  revision        Int      @default(0) @map("phienban")
  processingToken String?  @db.VarChar @map("makhoaxuly")
  processingUntil DateTime? @db.Timestamptz(6) @map("thoigianhethankhoa")
  createdAt       DateTime @default(now()) @db.Timestamptz(6) @map("thoigiantao")
  updatedAt       DateTime @updatedAt @db.Timestamptz(6) @map("thoigiancapnhat")
  confirmationExpiresAt DateTime? @map("thoigianhethanxacnhan") @db.Timestamptz(6)
  closedAt DateTime? @map("thoigiandong") @db.Timestamptz(6)
  memory bo_nho_chatbot?
  handoffs yeu_cau_chuyen_tiep_chatbot[]
  messages        tin_nhan_chatbot[]
  events          su_kien_chatbot[]
  assignedAgent   nhan_vien? @relation("SupportAssignee", fields: [assignedAgentId], references: [manhanvien], onDelete: NoAction, onUpdate: NoAction)

  @@index([ownerHash, createdAt])
  @@index([status, priority, updatedAt])
}

model tin_nhan_chatbot {
  id              String @id @db.VarChar @map("matinnhan")
  conversationId  String @db.VarChar @map("mahoithoai")
  sequence        Int @unique @default(autoincrement()) @map("thutu")
  role            nguoi_gui_chatbot_enum @map("nguoigui")
  text            String @map("noidung")
  originalText    String? @map("noidunggoc")
  clientMessageId String? @db.VarChar @map("mayeucauclient")
  agentId         String? @db.VarChar @map("manhanvien")
  createdAt       DateTime @default(now()) @db.Timestamptz(6) @map("thoigiantao")
  conversation    hoi_thoai_chatbot @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent           nhan_vien? @relation("SupportAuthor", fields: [agentId], references: [manhanvien], onDelete: NoAction, onUpdate: NoAction)

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, sequence])
}

model su_kien_chatbot {
  id             Int @id @default(autoincrement()) @map("masukien")
  conversationId String @db.VarChar @map("mahoithoai")
  type           String @db.VarChar(32) @map("loaisukien")
  data           Json @map("dulieu")
  createdAt      DateTime @default(now()) @db.Timestamptz(6) @map("thoigiantao")
  conversation   hoi_thoai_chatbot @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, id])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

