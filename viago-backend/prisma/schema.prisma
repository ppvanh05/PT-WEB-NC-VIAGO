  trangthai trang_thai_chuyen_tiep_chatbot_enum @default(ChoXacNhan)
  thoigianxacnhan DateTime? @db.Timestamptz(6)
  thoigianhethanxacnhan DateTime? @db.Timestamptz(6)
  manhanvien String? @db.VarChar
  thoigiantao DateTime @default(now()) @db.Timestamptz(6)
  thoigiangiaiquyet DateTime? @db.Timestamptz(6)
  ketquaxuly String?
  hoi_thoai_chatbot hoi_thoai_chatbot @relation(fields: [mahoithoai], references: [id], onDelete: Cascade)
  nhan_vien nhan_vien? @relation(fields: [manhanvien], references: [manhanvien], onDelete: NoAction, onUpdate: NoAction)
  phan_cong_chatbot phan_cong_chatbot[]
  @@index([trangthai, mucdouutien, thoigiantao])
  @@index([mahoithoai, thoigiantao])
}

model phan_cong_chatbot {
  maphancong String @id @db.VarChar
  mayeucau String @db.VarChar
  manhanvien String @db.VarChar
  thoigianphancong DateTime @default(now()) @db.Timestamptz(6)
  thoigiantiepnhan DateTime? @db.Timestamptz(6)
  thoigianketthuc DateTime? @db.Timestamptz(6)
  trangthai trang_thai_phan_cong_chatbot_enum @default(DaPhanCong)
  yeu_cau_chuyen_tiep_chatbot yeu_cau_chuyen_tiep_chatbot @relation(fields: [mayeucau], references: [mayeucau], onDelete: Cascade)
  nhan_vien nhan_vien @relation(fields: [manhanvien], references: [manhanvien], onDelete: NoAction, onUpdate: NoAction)
  @@index([manhanvien, trangthai])
}

model danh_muc_kien_thuc_chatbot {
  madanhmuc String @id @db.VarChar
  tendanhmuc String @unique @db.VarChar
  mota String?
  tai_lieu_kien_thuc_chatbot tai_lieu_kien_thuc_chatbot[]
}

model tai_lieu_kien_thuc_chatbot {
  matailieu String @id @db.VarChar
  madanhmuc String? @db.VarChar
  tieude String
  nguon String @unique
  duongdan String?
  noidung String
  mabamnoidung String @db.VarChar(64)
