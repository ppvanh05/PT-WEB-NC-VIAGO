// Workflow metadata is accessed through parameterised SQL to support existing deployments.
model quan_ly_tiep_nhan {
  loaidoituong String @db.VarChar
  madoituong String @db.VarChar
  manhanvienphutrach String? @db.VarChar
  mucdouutien String @default("BinhThuong") @db.VarChar
  danhgia String @default("")
  lichphongvan DateTime? @db.Timestamptz(6)
  phanhoinhap String @default("")
  capnhatluc DateTime @default(now()) @db.Timestamptz(6)
  phienban Int @default(0)
  nhan_vien nhan_vien? @relation(fields: [manhanvienphutrach], references: [manhanvien], onDelete: NoAction, onUpdate: NoAction)
  @@id([loaidoituong, madoituong])
  @@index([manhanvienphutrach], map: "quan_ly_tiep_nhan_phutrach_idx")
}
