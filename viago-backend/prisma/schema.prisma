model doan_kien_thuc_chatbot {
  madoan String @id @db.VarChar
  matailieu String @db.VarChar
  thutudoan Int
  noidung String
  embedding Unsupported("vector(1536)")?
  mohinhnhung String? @db.VarChar
  metadata Json?
  thoigiantao DateTime @default(now()) @db.Timestamptz(6)
  tai_lieu_kien_thuc_chatbot tai_lieu_kien_thuc_chatbot @relation(fields: [matailieu], references: [matailieu], onDelete: Cascade)
  @@unique([matailieu, thutudoan])
